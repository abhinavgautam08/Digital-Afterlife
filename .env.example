# Digital Afterlife - Environment Variables

APP_NAME="Digital Afterlife – Memory Keeper"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Network Binding (Strict local loopback)
HOST="127.0.0.1"
PORT=8000

# Storage Locations
DATABASE_URL="sqlite:///./data/digital_afterlife.db"

# Local Ollama AI Engine
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_SECONDS=3.0

# Security & Encryption (Phase 1 preparation)
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=""
MAX_UPLOAD_SIZE_BYTES=104857600

# Local Speech-to-Text (Phase 3)
WHISPER_DEFAULT_MODEL="base"
WHISPER_CPU_THREADS=4
AUTO_DOWNLOAD_MODELS=false

# Local Semantic Search & RAG (Phase 4)
EMBEDDING_DEFAULT_MODEL="multilingual-e5-small"
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55
RAG_TEMPERATURE=0.1

